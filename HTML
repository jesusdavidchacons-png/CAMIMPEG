<!DOCTYPE html>
<html lang="es" class="h-full bg-black text-white antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>CAMIMPEG | Ecosistema de Innovación & Negociación</title>
    
    <!-- Framework Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Tipografías ejecutivas: Space Grotesk e Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Iconografía Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            gold: '#D4AF37',
                            'gold-light': '#F6E7B0',
                            charcoal: '#0C0D0E',
                            card: '#121417',
                            border: '#23262B',
                            accent: '#C5A059'
                        }
                    },
                    boxShadow: {
                        'glow': '0 0 35px -5px rgba(212, 175, 55, 0.35)',
                        'glow-subtle': '0 0 20px -3px rgba(212, 175, 55, 0.15)'
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090A0C;
        }
        ::-webkit-scrollbar-thumb {
            background: #23262B;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }
        
        .glass-panel {
            background: rgba(14, 16, 20, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .touch-app {
            -webkit-touch-callout: none;
            -webkit-user-select: none;
            user-select: none;
        }

        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 0.3; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .animate-ring {
            animation: pulse-ring 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        /* Animación interactiva de rotación horizontal */
        @keyframes rotate-to-landscape {
            0% { transform: rotate(0deg) scale(0.95); }
            30% { transform: rotate(0deg) scale(0.95); }
            70% { transform: rotate(-90deg) scale(1.05); }
            100% { transform: rotate(-90deg) scale(1); }
        }
        .animate-device-rotate {
            animation: rotate-to-landscape 3.2s ease-in-out infinite alternate;
        }

        @keyframes sweep-radar {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-radar {
            animation: sweep-radar 8s linear infinite;
        }
    </style>
</head>

<body class="h-full bg-black text-white font-sans overflow-x-hidden touch-app selection:bg-brand-gold selection:text-black">

    <!-- ========================================================================= -->
    <!-- COMPUERTA DE ORIENTACIÓN: FUERZA MODO HORIZONTAL EN DISPOSITIVOS MÓVILES -->
    <!-- ========================================================================= -->
    <div id="orientationGate" class="fixed inset-0 z-[100] bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-between p-8 text-center transition-all duration-700 hidden">
        
        <!-- Header de la compuerta con Logo Oficial -->
        <div class="flex items-center gap-3 pt-4">
            <img src="https://i.postimg.cc/NFL6TcG9/LOGO-CAMIMPEG.png" alt="CAMIMPEG Logo" class="h-10 w-auto object-contain drop-shadow">
            <div class="text-left border-l border-zinc-700 pl-3">
                <span class="text-xs font-mono text-brand-gold tracking-widest uppercase block">Requisito de Proyección</span>
                <span class="text-[11px] text-zinc-400 font-sans">Formato Ejecutivo Horizontal</span>
            </div>
        </div>

        <!-- Gráfico interactivo 3D de rotación -->
        <div class="relative my-auto flex flex-col items-center">
            <!-- Anillo giroscópico con barrido -->
            <div class="w-64 h-64 rounded-full border border-brand-gold/20 flex items-center justify-center relative">
                <div class="absolute inset-0 rounded-full border-t border-brand-gold/60 animate-radar"></div>
                <div class="absolute inset-6 rounded-full border border-dashed border-zinc-800"></div>
                
                <!-- Ilustración del dispositivo rotando -->
                <div class="relative z-10 w-28 h-44 rounded-2xl border-2 border-brand-gold bg-zinc-950 p-1.5 shadow-glow animate-device-rotate flex flex-col justify-between items-center">
                    <div class="w-6 h-1 rounded-full bg-zinc-700"></div>
                    <div class="w-full flex-1 rounded-lg bg-zinc-900/90 border border-zinc-800 flex items-center justify-center overflow-hidden p-2">
                        <img src="https://i.postimg.cc/NFL6TcG9/LOGO-CAMIMPEG.png" alt="Logo Icon" class="h-6 w-auto opacity-70 object-contain">
                    </div>
                    <div class="w-3 h-3 rounded-full border border-zinc-700"></div>
                </div>
            </div>

            <div class="mt-8 max-w-sm">
                <h3 class="text-xl md:text-2xl font-display font-bold uppercase tracking-wider text-white">
                    Gire su Dispositivo
                </h3>
                <p class="text-xs text-zinc-400 mt-2 leading-relaxed">
                    Esta herramienta interactiva está configurada para proyecciones de alto nivel en formato panorámico (16:9). Rote su tablet o teléfono a posición horizontal para acceder.
                </p>
            </div>
        </div>

        <!-- Indicador de sensor activo -->
        <div class="flex items-center gap-2 pb-4 text-xs font-mono text-zinc-500">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>Esperando calibración giroscópica...</span>
        </div>
    </div>


    <div id="appContainer" class="relative w-full h-full min-h-screen bg-black flex flex-col">

        <!-- ========================================================================= -->
        <!-- PANTALLA 1: ANTESALA CON GIF ANIMADO + YOUTUBE FULLSCREEN -->
        <!-- ========================================================================= -->
        <section id="heroScreen" class="fixed inset-0 z-50 flex flex-col justify-between overflow-hidden bg-black transition-opacity duration-700">
            
            <!-- CAPA 1: ANTESALA CON GIF ANIMADO DE GIPHY -->
            <div id="splashLayer" class="absolute inset-0 z-10 flex flex-col justify-between transition-opacity duration-700">
                
                <!-- Fondo animado GIF -->
                <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
                    <img id="gifImageElement" 
                         src="https://media.giphy.com/media/GNeBk59rTEsnKpFPDe/giphy.gif" 
                         onerror="this.src='https://i.giphy.com/GNeBk59rTEsnKpFPDe.gif'"
                         alt="CAMIMPEG Despliegue de Operaciones" 
                         class="w-full h-full object-cover scale-105 filter brightness-[0.70] contrast-[1.15] transition-transform duration-1000">
                </div>

                <!-- Capas de contraste para legibilidad ejecutiva -->
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-black/75 z-0 pointer-events-none"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_15%,rgba(0,0,0,0.85)_100%)] z-0 pointer-events-none"></div>

                <!-- Barra superior con LOGO OFICIAL DE CAMIMPEG -->
                <header class="relative z-10 w-full px-6 md:px-10 py-6 flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <div class="h-14 px-3 rounded-2xl bg-black/60 backdrop-blur-md border border-brand-gold/30 flex items-center justify-center shadow-glow">
                            <img src="https://i.postimg.cc/NFL6TcG9/LOGO-CAMIMPEG.png" alt="CAMIMPEG Logo Oficial" class="h-10 w-auto object-contain">
                        </div>
                        <div>
                            <span class="font-display font-bold tracking-widest text-lg md:text-xl text-white block">CAMIMPEG</span>
                            <span class="text-[10px] uppercase tracking-widest text-zinc-400 font-medium">Compañía Anónima Militar de Industrias Mineras, Petrolíferas y de Gas</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-gold/10 border border-brand-gold/30 text-brand-gold-light text-xs font-mono">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ring"></span>
                            RELANZAMIENTO ESTRATÉGICO
                        </span>
                        <button id="toggleFullscreenBtn" title="Pantalla Completa" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 hover:border-brand-gold/50 flex items-center justify-center text-zinc-300 transition-colors cursor-pointer">
                            <i class="fa-solid fa-expand text-sm"></i>
                        </button>
                    </div>
                </header>

                <!-- Bloque central de impacto con el BOTÓN COMENZAR -->
                <div class="relative z-10 max-w-4xl mx-auto px-6 text-center my-auto flex flex-col items-center">
                    <div class="inline-flex items-center gap-2 mb-4 px-4 py-1.5 rounded-full glass-panel text-zinc-300 text-xs tracking-widest uppercase font-semibold border border-white/10">
                        <i class="fa-solid fa-circle-play text-brand-gold text-xs"></i>
                        Propuesta de Innovación Audiovisual & Inmersiva
                    </div>

                    <h1 class="text-4xl md:text-6xl font-display font-extrabold tracking-tight text-white leading-tight uppercase mb-4 drop-shadow-lg">
                        Solidez Operativa. <br>
                        <span class="bg-gradient-to-r from-brand-gold-light via-brand-gold to-yellow-600 bg-clip-text text-transparent">
                            Certeza para Inversionistas.
                        </span>
                    </h1>

                    <p class="max-w-2xl text-sm md:text-base text-zinc-300 font-normal leading-relaxed mb-8 drop-shadow">
                        Herramienta interactiva y ecosistema inmersivo diseñado para proyectar la magnitud real de las operaciones de CAMIMPEG en exposiciones internacionales y mesas de negociación bilateral.
                    </p>

                    <!-- BOTÓN COMENZAR -->
                    <button id="btnStartPresentation" class="group relative inline-flex items-center justify-center gap-4 px-10 py-5 rounded-2xl bg-brand-gold text-black font-display font-bold text-base md:text-lg tracking-wider uppercase transition-all duration-300 hover:bg-brand-gold-light hover:scale-105 shadow-glow active:scale-95 cursor-pointer">
                        <div class="w-9 h-9 rounded-full bg-black text-brand-gold flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                            <i class="fa-solid fa-play text-xs pl-0.5"></i>
                        </div>
                        <span>Comenzar Presentación</span>
                    </button>
                    
                    <span class="text-zinc-400 text-[11px] tracking-wider uppercase mt-4 block">Toque para reproducir video y acceder al entorno de negociación</span>
                </div>

                <!-- Pie de la antesala -->
                <footer class="relative z-10 w-full px-8 py-4 border-t border-white/10 glass-panel flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-400 gap-2">
                    <div class="flex items-center gap-2">
                        <img src="https://i.postimg.cc/NFL6TcG9/LOGO-CAMIMPEG.png" alt="Logo mini" class="h-4 w-auto opacity-70">
                        <span>Despliegue Estratégico de Innovación de Marca</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-lock text-brand-gold"></i>
                        <span>Uso Privado para la Junta Directiva y Aliados Estratégicos</span>
                    </div>
                </footer>
            </div>

            <!-- CAPA 2: REPRODUCTOR DE YOUTUBE -->
            <div id="youtubeLayer" class="absolute inset-0 z-20 hidden opacity-0 transition-opacity duration-700 flex flex-col bg-black">
                
                <!-- Barra superior flotante sobre el video de YouTube -->
                <div class="absolute top-0 left-0 right-0 z-30 px-6 py-4 flex items-center justify-between bg-gradient-to-b from-black/95 via-black/60 to-transparent pointer-events-auto">
                    <div class="flex items-center space-x-3">
                        <button id="btnBackToSplash" class="px-4 py-2 rounded-xl bg-black/70 backdrop-blur-md border border-white/20 text-white hover:border-brand-gold text-xs flex items-center gap-2 transition-colors cursor-pointer">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>Reiniciar</span>
                        </button>
                        <span class="text-xs font-mono tracking-widest text-zinc-300 uppercase hidden sm:inline-block">
                            <i class="fa-brands fa-youtube text-red-500 mr-1.5"></i> Video Institucional Master
                        </span>
                    </div>

                    <!-- BOTÓN CONTINUAR AL PORTAFOLIO -->
                    <button id="btnContinueFromVideo" class="px-6 py-2.5 rounded-xl bg-white text-black font-display font-bold text-xs uppercase tracking-wider hover:bg-brand-gold hover:text-black transition-all shadow-glow flex items-center gap-2 cursor-pointer">
                        <span>Continuar a las Líneas Estratégicas</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </div>

                <!-- Iframe del reproductor de YouTube -->
                <div class="w-full h-full relative bg-black flex items-center justify-center">
                    <iframe id="ytPlayerIframe" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                </div>
            </div>

        </section>


        <!-- ========================================================================= -->
        <!-- PANTALLA 2: CATÁLOGO DE LÍNEAS ESTRATÉGICAS (LN-01 a LN-06) -->
        <!-- ========================================================================= -->
        <main id="portfolioScreen" class="relative z-10 flex-1 flex flex-col opacity-0 pointer-events-none transition-opacity duration-700 pb-16">
            
            <!-- Barra de navegación fija superior con LOGO OFICIAL -->
            <nav class="sticky top-0 z-40 w-full glass-panel border-b border-brand-border/80 px-6 py-3.5 flex items-center justify-between">
                <div class="flex items-center space-x-4">
                    <button id="btnBackToHero" class="px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700 text-xs flex items-center gap-2 transition-colors cursor-pointer">
                        <i class="fa-solid fa-film text-xs"></i>
                        <span>Ver Video</span>
                    </button>
                    <div class="h-6 w-px bg-zinc-800"></div>
                    
                    <!-- Logo CAMIMPEG en barra principal -->
                    <div class="flex items-center gap-3">
                        <img src="https://i.postimg.cc/NFL6TcG9/LOGO-CAMIMPEG.png" alt="CAMIMPEG" class="h-8 w-auto object-contain">
                        <div>
                            <h2 class="font-display font-bold text-sm tracking-wide text-white">LÍNEAS ESTRATÉGICAS DE OPERACIÓN</h2>
                            <p class="text-[10px] text-zinc-400 font-mono">ECOSISTEMA DE NEGOCIACIÓN B2B</p>
                        </div>
                    </div>
                </div>

                <!-- Acciones directivas y dossier económico -->
                <div class="flex items-center gap-3">
                    <button id="btnOpenEcosystemModal" class="px-4 py-2 rounded-xl bg-brand-gold text-black font-display font-bold text-xs uppercase tracking-wider hover:bg-brand-gold-light transition-all flex items-center gap-2 shadow-glow cursor-pointer">
                        <i class="fa-solid fa-cube"></i>
                        <span>Dossier Ecosistema ($62.8K)</span>
                    </button>
                    <button id="btnOpenInquiryModal" class="px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 text-zinc-200 text-xs flex items-center gap-1.5 transition-colors cursor-pointer">
                        <i class="fa-solid fa-file-contract text-brand-gold"></i>
                        <span>Ficha Inversor</span>
                    </button>
                </div>
            </nav>

            <!-- Banner de posicionamiento internacional -->
            <section class="max-w-7xl mx-auto w-full px-6 pt-6">
                <div class="rounded-3xl bg-gradient-to-r from-zinc-950 via-zinc-900 to-zinc-950 border border-brand-gold/30 p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-glow-subtle">
                    <div class="max-w-3xl">
                        <div class="flex items-center gap-2 text-brand-gold text-xs font-mono tracking-widest uppercase mb-2">
                            <span class="w-2 h-2 rounded-full bg-brand-gold"></span> Innovación Tecnológica para el Relanzamiento de Marca
                        </div>
                        <h2 class="text-2xl md:text-3xl font-display font-bold text-white tracking-tight">
                            Elevando a CAMIMPEG a los Estándares de Negociación Internacional
                        </h2>
                        <p class="text-xs md:text-sm text-zinc-300 mt-2 leading-relaxed">
                            Sustituya las presentaciones tradicionales por un ecosistema digital de vanguardia. Esta plataforma y los recorridos inmersivos 360° permiten a los inversores validar en una tablet o pantalla la infraestructura real de sus 6 líneas de negocio sin traslados de riesgo ni dilaciones.
                        </p>
                    </div>

                    <div class="flex flex-col gap-2 shrink-0 w-full md:w-auto">
                        <div class="px-4 py-2.5 rounded-xl bg-black/60 border border-white/10 text-center">
                            <span class="text-[10px] font-mono uppercase text-zinc-400 block">Inversión del Ecosistema</span>
                            <span class="text-xl font-display font-bold text-brand-gold">USD 62.800</span>
                        </div>
                        <button onclick="document.getElementById('btnOpenEcosystemModal').click()" class="text-[11px] font-mono text-zinc-400 hover:text-white underline text-center transition-colors">
                            Ver Desglose de Producción y 360°
                        </button>
                    </div>
                </div>
            </section>

            <!-- Cabecera de filtros y buscador -->
            <section class="max-w-7xl mx-auto w-full px-6 pt-8 pb-4">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6">
                    <div>
                        <div class="flex items-center gap-2 text-brand-gold text-xs font-mono tracking-widest uppercase mb-1">
                            <i class="fa-solid fa-layer-group"></i> Cobertura en Terreno
                        </div>
                        <h2 class="text-2xl md:text-3xl font-display font-bold text-white tracking-tight">
                            Argumentario de Venta por Línea Estratégica
                        </h2>
                        <p class="text-xs text-zinc-400 max-w-xl mt-1">
                            Seleccione cada área para visualizar cómo el contenido audiovisual y los recorridos inmersivos demuestran la solvencia operativa ante el inversor.
                        </p>
                    </div>

                    <!-- Buscador ágil -->
                    <div class="relative w-full md:w-80">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-500 text-xs"></i>
                        <input type="text" id="searchInput" placeholder="Buscar por código, activo o línea..." class="w-full pl-9 pr-4 py-2.5 bg-zinc-950/80 border border-zinc-800 rounded-xl text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-brand-gold/60 transition-colors">
                    </div>
                </div>

                <!-- Botones de filtrado táctil -->
                <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="filterContainer">
                    <button data-filter="all" class="filter-btn active-pill px-4 py-2 rounded-xl text-xs font-semibold tracking-wider whitespace-nowrap bg-white text-black transition-all cursor-pointer">
                        Todas las Líneas (<span id="countAll">6</span>)
                    </button>
                    <button data-filter="hidrocarburos" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-01 Hidrocarburos
                    </button>
                    <button data-filter="mineria" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-02 Minería
                    </button>
                    <button data-filter="seguridad" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-03 Seguridad Integral
                    </button>
                    <button data-filter="transporte" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-04 Transporte Guanta
                    </button>
                    <button data-filter="comercializacion" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-05 Comercialización
                    </button>
                    <button data-filter="aduana" class="filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer">
                        LN-06 Aduana Exterior
                    </button>
                </div>
            </section>

            <!-- Rejilla de tarjetas dinámicas -->
            <section class="max-w-7xl mx-auto w-full px-6 flex-1">
                <div id="servicesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Tarjetas inyectadas por JavaScript -->
                </div>

                <div id="emptyState" class="hidden text-center py-20 border border-dashed border-zinc-800 rounded-3xl bg-zinc-950/40">
                    <i class="fa-regular fa-folder-open text-4xl text-zinc-600 mb-3"></i>
                    <h3 class="font-display font-semibold text-white text-base">No se encontraron líneas coincidentes</h3>
                    <p class="text-xs text-zinc-500 mt-1">Pruebe ajustando los términos de búsqueda o seleccionando otra categoría.</p>
                </div>
            </section>

            <!-- Métricas institucionales -->
            <section class="max-w-7xl mx-auto w-full px-6 mt-12">
                <div class="rounded-3xl glass-panel p-6 border border-zinc-800 grid grid-cols-2 md:grid-cols-4 gap-6">
                    <div class="border-r border-zinc-800/80 pr-4 last:border-none">
                        <span class="text-zinc-500 font-mono text-[10px] uppercase block tracking-wider">Líneas de Negocio</span>
                        <div class="text-2xl md:text-3xl font-display font-bold text-white mt-1">06 Áreas</div>
                        <p class="text-xs text-zinc-400 mt-0.5">Cobertura integral de la cadena operativa nacional.</p>
                    </div>
                    <div class="border-r border-zinc-800/80 pr-4 last:border-none">
                        <span class="text-zinc-500 font-mono text-[10px] uppercase block tracking-wider">Validación Inmersiva</span>
                        <div class="text-2xl md:text-3xl font-display font-bold text-brand-gold mt-1">360° Real</div>
                        <p class="text-xs text-zinc-400 mt-0.5">Comprobación visual de infraestructura y equipos activos.</p>
                    </div>
                    <div class="border-r border-zinc-800/80 pr-4 last:border-none">
                        <span class="text-zinc-500 font-mono text-[10px] uppercase block tracking-wider">Jornadas en Terreno</span>
                        <div class="text-2xl md:text-3xl font-display font-bold text-white mt-1">24 Días</div>
                        <p class="text-xs text-zinc-400 mt-0.5">12 días cinematografía y 12 días captura inmersiva 360°.</p>
                    </div>
                    <div>

            document.getElementById('toastTitle').textContent = title;
            document.getElementById('toastSub').textContent = subtitle;
            
            toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
            }, 3500);
        }

        // Renderizado dinámico de las 6 líneas estratégicas
        function renderServices() {
            countAll.textContent = strategicLinesData.length;
            const searchTerm = searchInput.value.toLowerCase().trim();

            const filtered = strategicLinesData.filter(serv => {
                const matchCategory = currentFilter === 'all' || serv.category === currentFilter;
                const matchSearch = serv.title.toLowerCase().includes(searchTerm) || 
                                    serv.description.toLowerCase().includes(searchTerm) ||
                                    serv.code.toLowerCase().includes(searchTerm);
                return matchCategory && matchSearch;
            });

            servicesGrid.innerHTML = '';

            if (filtered.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');
                filtered.forEach(service => {
                    const card = document.createElement('div');
                    card.className = "group relative rounded-3xl bg-zinc-950 border border-zinc-800/90 p-6 flex flex-col justify-between hover:border-brand-gold/60 transition-all duration-300 hover:shadow-glow hover:-translate-y-1";
                    
                    card.innerHTML = `
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-[10px] font-mono tracking-widest text-brand-gold uppercase px-2.5 py-1 rounded-full bg-brand-gold/10 border border-brand-gold/30">
                                    ${service.categoryLabel}
                                </span>
                                <span class="text-white font-mono text-xs font-bold">${service.code}</span>
                            </div>

                            <div class="flex items-start gap-3.5 mb-3">
                                <div class="w-12 h-12 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center text-brand-gold text-lg shrink-0 group-hover:scale-110 group-hover:bg-brand-gold group-hover:text-black transition-all duration-300">
                                    <i class="fa-solid ${service.icon}"></i>
                                </div>
                                <h3 class="text-base font-display font-bold text-white group-hover:text-brand-gold-light transition-colors leading-snug">
                                    ${service.title}
                                </h3>
                            </div>

                            <p class="text-xs text-zinc-400 leading-relaxed mb-4">
                                ${service.description}
                            </p>

                            <div class="p-3 rounded-xl bg-zinc-900/60 border border-zinc-800/80 mb-4">
                                <span class="text-[10px] font-mono uppercase text-brand-gold block font-semibold mb-0.5">
                                    <i class="fa-solid fa-check text-[9px] mr-1"></i> Certeza para el Inversor:
                                </span>
                                <p class="text-[11px] text-zinc-300 line-clamp-2">
                                    ${service.pitchProof}
                                </p>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-zinc-900 flex items-center justify-between">
                            <span class="text-[11px] text-zinc-500 font-mono flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Cobertura 360° & Video
                            </span>
                            <button onclick="openDetailModal(${service.id})" class="px-3.5 py-1.5 rounded-xl bg-zinc-900 hover:bg-white hover:text-black border border-zinc-800 text-zinc-200 text-xs font-semibold tracking-wider transition-all flex items-center gap-1.5 cursor-pointer">
                                <span>Plan de Venta</span>
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </button>
                        </div>
                    `;
                    servicesGrid.appendChild(card);
                });
            }
        }

        // Filtros táctiles
        filterContainer.addEventListener('click', (e) => {
            const btn = e.target.closest('.filter-btn');
            if (!btn) return;

            document.querySelectorAll('.filter-btn').forEach(b => {
                b.className = "filter-btn px-4 py-2 rounded-xl text-xs font-medium tracking-wider whitespace-nowrap bg-zinc-900 border border-zinc-800 text-zinc-300 hover:border-zinc-700 transition-all cursor-pointer";
            });

            btn.className = "filter-btn active-pill px-4 py-2 rounded-xl text-xs font-semibold tracking-wider whitespace-nowrap bg-white text-black transition-all cursor-pointer";
            currentFilter = btn.dataset.filter;
            renderServices();
        });

        searchInput.addEventListener('input', renderServices);

        // Modales
        const serviceDetailModal = document.getElementById('serviceDetailModal');
        const ecosystemModal = document.getElementById('ecosystemModal');
        const inquiryModal = document.getElementById('inquiryModal');

        window.openDetailModal = function(serviceId) {
            const item = strategicLinesData.find(s => s.id === serviceId);
            if (!item) return;

            document.getElementById('detailCategoryBadge').textContent = item.categoryLabel;
            document.getElementById('detailServiceCode').textContent = item.code;
            document.getElementById('detailTitle').textContent = item.title;
            document.getElementById('detailDescription').textContent = item.description;
            document.getElementById('detailPainPoint').textContent = item.painPoint;
            document.getElementById('detailPitchProof').textContent = item.pitchProof;

            const bulletsList = document.getElementById('detailBullets');
            bulletsList.innerHTML = '';
            item.bullets.forEach(b => {
                const li = document.createElement('li');
                li.className = "flex items-start gap-2";
                li.innerHTML = `<i class="fa-solid fa-video text-brand-gold text-[10px] mt-1 shrink-0"></i> <span>${b}</span>`;
                bulletsList.appendChild(li);
            });

            serviceDetailModal.classList.remove('hidden');
            serviceDetailModal.classList.add('flex');
        };

        document.getElementById('btnCloseDetailModal').addEventListener('click', () => {
            serviceDetailModal.classList.add('hidden');
            serviceDetailModal.classList.remove('flex');
        });

        document.getElementById('btnRequestDossier').addEventListener('click', () => {
            serviceDetailModal.classList.add('hidden');
            serviceDetailModal.classList.remove('flex');
            showToast("Línea Integrada", "Se ha añadido el argumentario al temario de la reunión bilateral.");
        });

        // Modal Ecosistema ($62.8K)
        document.getElementById('btnOpenEcosystemModal').addEventListener('click', () => {
            ecosystemModal.classList.remove('hidden');
            ecosystemModal.classList.add('flex');
        });

        document.getElementById('btnCloseEcosystemModal').addEventListener('click', () => {
            ecosystemModal.classList.add('hidden');
            ecosystemModal.classList.remove('flex');
        });

        // Ficha de Inversión
        document.getElementById('btnOpenInquiryModal').addEventListener('click', () => {
            inquiryModal.classList.remove('hidden');
            inquiryModal.classList.add('flex');
        });

        document.getElementById('btnCloseInquiryModal').addEventListener('click', () => {
            inquiryModal.classList.add('hidden');
            inquiryModal.classList.remove('flex');
        });

        document.getElementById('inquiryForm').addEventListener('submit', (e) => {
            e.preventDefault();
            const company = document.getElementById('inputCompany').value;
            inquiryModal.classList.add('hidden');
            inquiryModal.classList.remove('flex');
            showToast("Interés Registrado", `Ficha emitida formalmente para ${company}.`);
            e.target.reset();
        });

        // Cerrar modales tocando el fondo
        [serviceDetailModal, ecosystemModal, inquiryModal].forEach(modal => {
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            });
        });

        // Render inicial
        renderServices();
    </script>
</body>
</html>
